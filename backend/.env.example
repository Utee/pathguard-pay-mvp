APP_NAME=PathGuard Pay
DATABASE_URL=sqlite:///./pathguard_pay.db
# Render PostgreSQL URLs (postgres:// or postgresql://) use psycopg automatically.
# Hosted API origin; derives PayPal callbacks unless explicitly overridden below.
# PUBLIC_API_URL=https://your-api.onrender.com
PAYPAL_FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# All AI features use OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# PayPal Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_VAULT_ENCRYPTION_KEY=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://127.0.0.1:8000/api/payments/paypal/return
PAYPAL_CANCEL_URL=http://127.0.0.1:8000/api/payments/paypal/cancel
PAYPAL_CONNECTION_RETURN_URL=http://127.0.0.1:8000/api/paypal/connection/return
PAYPAL_CONNECTION_CANCEL_URL=http://127.0.0.1:8000/api/paypal/connection/cancel

